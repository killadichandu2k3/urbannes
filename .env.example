# UrbanNest — environment variable reference & configuration template.
# -----------------------------------------------------------------------------
# docker-compose.yml sets sensible defaults for every service, so you do NOT
# need to copy this to .env to run `docker compose up`. This file serves as
# a template and reference for what each environment variable does, and for
# running microservices directly with `npm run dev` outside Docker.

# ---- Database (Postgres) ---------------------------------------------------
PGHOST=localhost
PGPORT=5432
PGUSER=urbannest
PGPASSWORD=urbannest
PGDATABASE=urbannest

# ---- Redis Cache (cache-aside for auth-api, analytics-api, booking-worker) -
REDIS_CACHE_HOST=localhost
REDIS_CACHE_PORT=6380

# ---- Coordination Redis (seat locks + Pub/Sub reply/push channels) ---------
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- Kafka ------------------------------------------------------------------
KAFKA_BROKERS=localhost:9092

# ---- JWT Authentication ----------------------------------------------------
JWT_SECRET=urbannest-dev-jwt-secret-change-me

# ---- Payments (Razorpay — TEST MODE) ---------------------------------------
# Get test keys from the Razorpay Dashboard -> Settings -> API Keys (Test Mode).
# Test key IDs start with `rzp_test_`.
# If not set, payment order creation runs in simulation mode.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret

# ---- Email (Resend — free tier) -------------------------------------------
# Get an API key at https://resend.com/api-keys.
# Used by auth-api (OTP verification emails) and notification-service (booking emails).
# If not set, services log codes/emails to container output instead of failing.
RESEND_API_KEY=re_xxxxxxxxxxxx
NOTIFICATIONS_FROM_EMAIL=UrbanNest <onboarding@resend.dev>

# ---- Service Ports (when running outside Docker) --------------------------
# booking-api: 4000
# notification-service: 4100
# chat-service: 4200
# analytics-api: 4300
# gateway-graphql: 4500
# auth-api: 4600
