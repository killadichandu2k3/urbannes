# UrbanNest — environment variable reference.
# -----------------------------------------------------------------------------
# docker-compose.yml already sets sensible defaults for every service, so
# you do NOT need to copy this to .env to run `docker compose up`. This
# file exists as a reference for what each variable does, and for anyone
# running a service directly with `npm run dev` outside Docker (in which
# case these defaults point at localhost ports, matching what
# docker-compose.yml exposes on the host).

# ---- Kafka ------------------------------------------------------------------
KAFKA_BROKERS=localhost:9092

# ---- Postgres shards ----------------------------------------------------------
PG_SHARD_NODES=shard-0,shard-1
PG_SHARD_0_HOST=localhost
PG_SHARD_0_PORT=5433
PG_SHARD_1_HOST=localhost
PG_SHARD_1_PORT=5434
PGUSER=urbannest
PGPASSWORD=urbannest
PGDATABASE=urbannest

# ---- Redis Cluster (cache-aside) ---------------------------------------------
REDIS_CLUSTER_NODES=localhost:7000,localhost:7001,localhost:7002,localhost:7003,localhost:7004,localhost:7005

# ---- Coordination Redis (seat locks + pub/sub) -------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_LOCK_HOST=localhost
REDIS_LOCK_PORT=6379
SEAT_LOCK_TTL_MS=300000

# ---- booking-api --------------------------------------------------------------
PORT=4000
REPLY_TIMEOUT_MS=5000
PUBLIC_SHORT_URL_BASE=http://localhost:8080/s

# ---- notification-service ------------------------------------------------------
# PORT=4100 (health endpoint only)

# ---- Payments (Razorpay — TEST MODE, permanently free, no live business
# verification needed) ---------------------------------------------------------
# Get test keys from the Razorpay Dashboard -> Settings -> API Keys (Test
# Mode toggle in the top bar). Test key ids start with `rzp_test_`.
# Without these set, booking-worker logs a warning and payment order
# creation will fail — see services/booking-worker/src/payments/razorpay.ts.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret

# ---- Email (Resend — free tier: 3,000 sends/month, 100/day, no card
# required) -----------------------------------------------------------------
# Get an API key at https://resend.com/api-keys. Used by auth-api (OTP
# verification codes — see services/auth-api/src/otp.ts) and
# notification-service (booking confirmation emails — see
# services/notification-service/src/patterns/adapter/ChannelAdapters.ts).
# Without this set, both services log the content they would have sent
# instead of failing, so local dev works without a Resend account.
RESEND_API_KEY=re_xxxxxxxxxxxx
# Resend's sandbox sender — replace with your own verified domain's
# address once you add one in the Resend dashboard.
NOTIFICATIONS_FROM_EMAIL=UrbanNest <onboarding@resend.dev>

# ---- chat-service ---------------------------------------------------------------
# PORT=4200
